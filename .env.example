# Loaded from the repository root by pnpm start:collector and pnpm smoke:collector.
NODE_ENV=development
HOST=127.0.0.1
PORT=4318
LOG_LEVEL=info

# Required for collector startup, including loopback. Generate with openssl rand -hex 32.
# TIMEMACHINE_AUTH_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Per-process, per-client-IP rate limit; public health probes are exempt.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Temporary in-memory storage. Incidents are lost on restart.
INCIDENT_STORE_MAX_ENTRIES=1000
INCIDENT_STORE_MAX_BYTES=16777216
INCIDENT_RETENTION_MS=3600000
SHUTDOWN_TIMEOUT_MS=10000

# Select memory for temporary development or postgres for durable storage.
STORAGE_DRIVER=memory
DATABASE_SSL=require
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=5000
DATABASE_RETENTION_DAYS=30
# DATABASE_CA_FILE=/path/to/trusted-ca.pem
# pnpm db:setup configures local Docker PostgreSQL with TLS disabled.
# DATABASE_URL=postgresql://timemachine:password@127.0.0.1:5432/timemachine

# Optional SDK example settings; defaults use the collector PORT above.
# EXAMPLE_PORT=4319
# TIMEMACHINE_COLLECTOR_URL=http://127.0.0.1:4318

# Dashboard sign-in and server-side collector connection.
# Run pnpm setup:dashboard to generate these in the ignored .env.
# DASHBOARD_PASSWORD=use-a-separate-workspace-password-at-least-12-characters
# DASHBOARD_SESSION_SECRET=replace-with-an-independent-random-secret
DASHBOARD_ORIGIN=http://127.0.0.1:4321

# Delivery example: pnpm demo supplies recorder/replay settings automatically.
# The page runs on 4322 and its synthetic pricing dependency on 4330.

# Optional local developer registry for custom Express replay images.
# REPLAY_APPS_FILE=/absolute/path/.timemachine/replay-apps.json
# REPLAY_FIXTURES_FILE=/absolute/path/.timemachine/profile-api-fixtures.json

# Optional automatic Node recorder identity (pnpm record -- node app.js)
# TIMEMACHINE_SERVICE_NAME=my-api
# TIMEMACHINE_SERVICE_VERSION=0.1.0
# TIMEMACHINE_ENVIRONMENT=development
# Optional reviewed request/dependency field policy, loaded at recorder startup
# TIMEMACHINE_RECORDING_POLICY=/absolute/path/to/recording-policy.json
# Trusted captured app image ID printed by replay:register (automatic replay generation)
# TIMEMACHINE_REPLAY_ARTIFACT_ID=sha256:replace-with-registered-image-id

# Separate delivery example PostgreSQL database; pnpm demo prepares private credentials.
# DELIVERY_POSTGRES_PORT=55435
# DELIVERY_POSTGRES_PASSWORD=generated-randomly
# DELIVERY_DATABASE_URL=postgresql://delivery:password@127.0.0.1:55435/delivery

# Optional single-channel issue alerts; use ALERT_CHANNELS below for several.
# ALERT_CHANNEL=webhook
# ALERT_WEBHOOK_URL=https://your-server.example/timemachine-alerts
# For Slack, use ALERT_CHANNEL=slack and your incoming webhook URL.
# ALERT_WEBHOOK_SECRET=at-least-32-random-characters-for-webhook-signatures
# ALERT_DASHBOARD_ORIGIN=https://timemachine.your-company.example
# Local testing: ALERT_WEBHOOK_URL=http://127.0.0.1:4340/alerts

# Optional SMTP email alerts; only the selected channel sends.
# ALERT_CHANNEL=email
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# ALERT_EMAIL_FROM=alerts@your-company.example
# ALERT_EMAIL_TO=developers@your-company.example

# Teams Workflows: ALERT_CHANNEL=teams, ALERT_WEBHOOK_URL=<complete secret workflow URL>
# Discord: ALERT_CHANNEL=discord, ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Simultaneous alerts; overrides ALERT_CHANNEL. Every selected destination is required.
# ALERT_CHANNELS=slack,email,teams,discord
# ALERT_SLACK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/PATH
# ALERT_TEAMS_URL=https://your-complete-teams-workflow-url
# ALERT_DISCORD_URL=https://discord.com/api/webhooks/ID/TOKEN
# Include webhook in ALERT_CHANNELS to also use ALERT_WEBHOOK_URL.

# Enables encrypted dashboard notification settings; generate via pnpm setup:notifications.
# NOTIFICATION_ENCRYPTION_KEY=<64 hexadecimal characters; keep and back up privately>

# Individual workspace accounts (bootstrap applies once to an empty workspace table).
# WORKSPACE_AUTH_MODE=accounts
# WORKSPACE_ADMIN_EMAIL=admin@your-company.example
# WORKSPACE_ADMIN_PASSWORD=initial-password-at-least-12-characters
